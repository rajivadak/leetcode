	Threads:
		Code 1:
			#include <iostream>
			#include <thread>
			
			static bool s_finished = false;
			
			void DoWork()
			{
				while(!s_finished)
				{
					std::cout << "working..... \n";
				}
			} 
			
			int main()
			{
				
				std::thread worker(DoWork);     //1. Thread is opened, and work starts executing in the DoWork function
				
				std::cin.get();					//2. While the above thread continuosly prints, this other thread wait for an input "enter" from the user
				s_finished = true;				//3. Once the user presses enter, the falg becomes true, and this make the above print statement stop
				
				worker.join();					//4. The above execution wait until point 1, until the user first presses enter,
												// after that it executes point 2 & 3, and then after that it come to point 4, and not the thread stops.
				
				std::cin.get();					//5. Once the user presses enter again, the program terminates
			}
			
